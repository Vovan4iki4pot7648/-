# ==================== АППРОКСИМАЦИЯ ====================

async def perform_linear_approximation(update: Update, context: ContextTypes.DEFAULT_TYPE, points: list):
    """Выполняет линейную аппроксимацию и строит график"""
    user_id = update.effective_user.id

    # Извлекаем координаты и погрешности
    x_coords = [p[0] for p in points]
    error_x_coords = [p[1] for p in points]
    y_coords = [p[2] for p in points]
    error_y_coords = [p[3] for p in points]

    try:
        # Выполняем линейную аппроксимацию
        k_mean, b_mean = np.polyfit(x_coords, y_coords, 1)
        
        # Создаем график
        plt.figure(figsize=(14, 9))

        # Рисуем точки с погрешностями
        plt.errorbar(
            x_coords, y_coords,
            xerr=error_x_coords,
            yerr=error_y_coords,
            fmt='o',
            color='blue',
            ecolor='red',
            elinewidth=1.5,
            capsize=4,
            capthick=1.5,
            markersize=8,
            alpha=0.8,
            label='Экспериментальные точки с погрешностями'
        )

        # Линия аппроксимации
        x_fit = np.linspace(min(x_coords), max(x_coords), 100)
        y_fit = k_mean * x_fit + b_mean
        plt.plot(x_fit, y_fit, 'g-', linewidth=2.5, 
                label=f'Аппроксимация: y = {k_mean:.3f}x + {b_mean:.3f}')

        # Вычисляем площадь под графиком
        area = (k_mean/2 * max(x_coords)**2 + b_mean * max(x_coords)) - \
               (k_mean/2 * min(x_coords)**2 + b_mean * min(x_coords))

        # Оформление графика
        plt.grid(True, alpha=0.3, linestyle='--')
        plt.xlabel('X', fontsize=12)
        plt.ylabel('Y', fontsize=12)
        plt.legend(fontsize=10, loc='best')

        # Сохраняем график во временный файл
        with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as tmpfile:
            plt.savefig(tmpfile.name, dpi=120, bbox_inches='tight', facecolor='white')
            tmpfile_path = tmpfile.name

        plt.close()

        # Формируем ответ с результатами
        caption = (
            f"Линейная аппроксимация выполнена!\n\n"
            f"Результаты:\n"
            f"Коэффициент наклона: k = {k_mean:.3f}\n"
            f"Свободный член: b = {b_mean:.3f}\n"
            f"Площадь под графиком: S = {area:.3f}\n\n"
        )

        # Отправляем график пользователю
        with open(tmpfile_path, 'rb') as photo:
            await context.bot.send_photo(
                chat_id=update.effective_chat.id,
                photo=photo,
                caption=caption
            )

        os.unlink(tmpfile_path)

    except Exception as e:
        await context.bot.send_message(
            chat_id=update.effective_chat.id,
            text=f"Ошибка при построении графика: {str(e)}"
        )
        plt.close()

    finally:
        user_states.pop(user_id, None)

# ==================== МАТЕМАТИЧЕСКИЕ ВЫЧИСЛЕНИЯ ====================

def calculate_derivative(func_str: str) -> str:
    """Вычисляет производную математической функции."""
    try:
        x = sp.symbols('x')

        local_dict = {
            'sin': sp.sin, 'cos': sp.cos, 'tan': sp.tan,
            'log': sp.log, 'ln': sp.log, 'exp': sp.exp,
            'sqrt': sp.sqrt, 'pi': sp.pi, 'e': sp.E
        }

        fu = sp.sympify(func_str, locals=local_dict)
        derivative_fu = sp.diff(fu, x)
        simplified = sp.simplify(derivative_fu)

        return (
            f"Исходная функция: {sp.pretty(fu, use_unicode=True)}\n\n"
            f"Производная: {sp.pretty(simplified, use_unicode=True)}"
        )

    except sp.SympifyError as e:
        return f"Ошибка в синтаксисе функции: {str(e)}"
    except Exception as e:
        return f"Непредвиденная ошибка: {str(e)}"

def calculate_integral(func_str: str) -> str:
    """Вычисляет неопределенный интеграл функции."""
    try:
        x = sp.symbols('x')

        local_dict = {
            'sin': sp.sin, 'cos': sp.cos, 'tan': sp.tan,
            'log': sp.log, 'ln': sp.log, 'exp': sp.exp,
            'sqrt': sp.sqrt, 'pi': sp.pi, 'e': sp.E
        }

        fu = sp.sympify(func_str, locals=local_dict)
        integral_fu = sp.integrate(fu, x)

        return (
            f"Исходная функция: f(x) = {sp.pretty(fu, use_unicode=True)}\n\n"
            f"Интеграл: ∫ f(x)dx = \n\n{sp.pretty(integral_fu, use_unicode=True)} + C"
        )

    except sp.SympifyError as e:
        return f"Ошибка в синтаксисе функции: {str(e)}"
    except Exception as e:
        return f"Непредвиденная ошибка: {str(e)}"

# ==================== ОБРАБОТЧИК ТЕКСТОВЫХ СООБЩЕНИЙ ====================

async def text_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработчик текстовых сообщений"""
    user_id = update.effective_user.id
    message_text = update.message.text
    state = user_states.get(user_id)

    # Обработка ввода функции для производной
    if state == 'waiting_for_derivative':
        try:
            result = calculate_derivative(message_text)
            await update.message.reply_text(f"Результат:\n{result}")
        except Exception as e:
            await update.message.reply_text(f"Ошибка: {str(e)}")
        finally:
            user_states.pop(user_id, None)
        return

    # Обработка ввода функции для интеграла
    elif state == 'waiting_for_integral':
        try:
            result = calculate_integral(message_text)
            await update.message.reply_text(f"Результат:\n{result}")
        except Exception as e:
            await update.message.reply_text(f"Ошибка: {str(e)}")
        finally:
            user_states.pop(user_id, None)
        return

    # Обработка ввода точек для аппроксимации
    elif state == 'waiting_for_points':
        try:
            parts = message_text.split()
            if len(parts) != 4:
                raise ValueError("Нужно 4 числа")

            x, error_x, y, error_y = map(float, parts)
            points = context.user_data.get('points', [])
            points.append((x, error_x, y, error_y))
            context.user_data['points'] = points

            await update.message.reply_text(
                f"Точка добавлена:\n"
                f"   x = ({x} ± {error_x})\n"
                f"   y = ({y} ± {error_y})\n"
                f"Всего точек: {len(points)}\n"
                f"Отправьте /done когда закончите."
            )
        except ValueError:
            await update.message.reply_text(
                "Ошибка! Введите 4 числа через пробел: x error_x y error_y\n"
                "Например: 1 0.1 2 0.2"
            )
        return

    # Обработка обычных сообщений
    message_lower = message_text.lower()
    if "привет" in message_lower:
        await update.message.reply_text("👋")
    elif "как дела" in message_lower:
        await update.message.reply_text("😊")
    else:
        await update.message.reply_text("🤔")

