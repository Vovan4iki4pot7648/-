    points = context.user_data.get('points', [])

    if len(points) < 2:
        await update.message.reply_text("Нужно минимум 2 точки для аппроксимации!")
        return

    # Формируем текст со списком введенных точек
    points_text = "Введенные точки:\n"
    for i, (x, err_x, y, err_y) in enumerate(points, 1):
        points_text += f"{i}. x = {x} ± {err_x}, y = {y} ± {err_y}\n"

    await update.message.reply_text(points_text + "\nВыполняется линейная аппроксимация...")

    # Сразу выполняем линейную аппроксимацию
    await perform_linear_approximation(update, context, points)

