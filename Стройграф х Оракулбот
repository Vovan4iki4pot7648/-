async def done_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Команда для завершения ввода точек и построения линейной аппроксимации"""
    user_id = update.effective_user.id
    points = context.user_data.get('points', [])
    
    if len(points) < 2:
        await update.message.reply_text("❌ Нужно минимум 2 точки для аппроксимации!")
        return
    
    # Сохраняем точки в контекст
    context.user_data['points_processed'] = points
    
    # Создаем клавиатуру только с линейной аппроксимацией
    keyboard = [
        [InlineKeyboardButton("Линейная: y = kx + b", callback_data='approx_linear')]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    # Показываем введенные точки
    points_text = "📌 Введенные точки:\n"
    for i, (x, err_x, y, err_y) in enumerate(points, 1):
        points_text += f"{i}. x={x} ± {err_x}, y={y} ± {err_y}\n"
    
    await update.message.reply_text(
        f"{points_text}\n\nВыберите тип аппроксимации (доступна только линейная):",
        reply_markup=reply_markup
    )
    
    r[user_id] = 'waiting_for_approximation_choice'

