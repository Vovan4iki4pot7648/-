async def handle_linear_approximation(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработка линейной аппроксимации"""
    query = update.callback_query
    user_id = update.effective_user.id
    points = context.user_data.get('points_processed', [])

    if not points:
        await query.edit_message_text("❌ Ошибка: точки не найдены")
        return

    # Распаковываем точки
    x_coords = [p[0] for p in points]
    error_x_coords = [p[1] for p in points]
    y_coords = [p[2] for p in points]
    error_y_coords = [p[3] for p in points]

    try:
        # Создаем график
        plt.figure(figsize=(12, 8))

        # Добавляем точки с погрешностями
        plt.errorbar(x_coords, y_coords,
                     xerr=error_x_coords,
                     yerr=error_y_coords,
                     fmt='o',
                     color='blue',
                     ecolor='red',
                     elinewidth=1.5,
                     capsize=4,
                     capthick=1.5,
                     markersize=6,
                     alpha=0.8,
                     label='Экспериментальные точки с погрешностями')

        # Линейная аппроксимация
        x_fit = np.linspace(min(x_coords), max(x_coords), 100)
        k, b = np.polyfit(x_coords, y_coords, 1)
        y_fit = k * x_fit + b
        plt.plot(x_fit, y_fit, 'g-', linewidth=2.5, label=f'Линейная аппроксимация: y = {k:.3f}x + {b:.3f}')

        # Вычисляем площадь под графиком
        area = (k/2 * max(x_coords)**2 + b * max(x_coords)) - (k/2 * min(x_coords)**2 + b * min(x_coords))
        plt.fill_between(x_fit, y_fit, alpha=0.2, color='green', label=f'Площадь = {area:.3f}')

        # Настройка графика
        plt.grid(True, alpha=0.3, linestyle='--')
        plt.xlabel('X', fontsize=12)
        plt.ylabel('Y', fontsize=12)
        plt.title('Линейная аппроксимация')
        plt.legend(fontsize=10, loc='best')

        # Сохраняем график
        with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as tmpfile:
            plt.savefig(tmpfile.name, dpi=120, bbox_inches='tight', facecolor='white')
            tmpfile_path = tmpfile.name

        plt.close()

        # Отправляем график
        with open(tmpfile_path, 'rb') as photo:
            await query.edit_message_text("✅ Линейная аппроксимация выполнена!")
            await context.bot.send_photo(chat_id=update.effective_chat.id, photo=photo)

        # Удаляем временный файл
        os.unlink(tmpfile_path)

    except Exception as e:
        await query.edit_message_text(f"❌ Ошибка при построении графика: {str(e)}")
        plt.close()

    # Очищаем состояние
    r.pop(user_id, None)

def calculate_derivative(func_str: str) -> str:
    """Вычисляет производную математической функции."""
    try:
        # Определяем символьную переменную
        x = sp.symbols('x')

        # Преобразуем строку в символьное выражение
        # Добавляем поддержку распространенных математических функций
        local_dict = {
            'sin': sp.sin,
            'cos': sp.cos,
            'tan': sp.tan,
            'log': sp.log,
            'ln': sp.log,
            'exp': sp.exp,
            'sqrt': sp.sqrt,
            'pi': sp.pi,
            'e': sp.E
        }

        fu = sp.sympify(func_str, locals=local_dict)

        # Вычисляем производную
        derivative_fu = sp.diff(fu, x)

        # Упрощаем результат
        simplified = sp.simplify(derivative_fu)

        # Форматируем вывод
        return (f"📐 Исходная функция: {sp.pretty(fu, use_unicode=True)}\n\n"
                f"📈 Производная: {sp.pretty(simplified, use_unicode=True)}")

    except sp.SympifyError as e:
        return f"❌ Ошибка в синтаксисе функции: {str(e)}"
    except Exception as e:
        return f"❌ Непредвиденная ошибка: {str(e)}"

async def text_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    message_text = update.message.text

    # Обработка ввода функции для производной
    if user_id in r and r[user_id] == 'waiting_for_the_function':
        try:
            res = calculate_derivative(message_text)
            await update.message.reply_text(f"Результат:\n{res}")
        except Exception as e:
            await update.message.reply_text(f"❌ Ошибка: {str(e)}")
        r.pop(user_id, None)
        return

    # Обработка ввода точек для аппроксимации
    elif user_id in r and r[user_id] == 'waiting_for_points':
        try:
            x, error_x, y, error_y = map(float, message_text.split())
            points = context.user_data.get('points', [])
            points.append((x, error_x, y, error_y))
            context.user_data['points'] = points
            await update.message.reply_text(
                f"✅ Точка добавлена:\n"
                f"   x = ({x} ± {error_x})\n"
                f"   y = ({y} ± {error_y})\n"
                f"Всего точек: {len(points)}\n"
                f"Отправьте /done когда закончите."
            )
        except ValueError:
            await update.message.reply_text(
                "❌ Ошибка! Введите 4 числа через пробел: x error_x y error_y\n"
                "Например: 1 0.1 2 0.1"
            )
        return

    # Обычные текстовые ответы
    message_text_lower = message_text.lower()
    if "привет" in message_text_lower:
        await update.message.reply_text("👋")
    elif "как дела" in message_text_lower:
        await update.message.reply_text("😊")
    else:
        await update.message.reply_text("👍")

