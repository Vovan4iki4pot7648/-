# ==================== АППРОКСИМАЦИЯ ====================

async def perform_linear_approximation(update: Update, context: ContextTypes.DEFAULT_TYPE, points: list):
    user_id = update.effective_user.id

    sorted_points = sorted(points, key=lambda p: p[0])

    x_coords = [p[0] for p in sorted_points]
    error_x_coords = [p[1] for p in sorted_points]
    y_coords = [p[2] for p in sorted_points]
    error_y_coords = [p[3] for p in sorted_points]

    try:
        k_mean, b_mean = np.polyfit(x_coords, y_coords, 1)

        x1, dx1, y1, dy1 = sorted_points[0]
        xN, dxN, yN, dyN = sorted_points[-1]

        max_left = (x1+dx1, y1-dy1)
        max_right = (xN-dxN, yN+dyN)
        if max_right[0] != max_left[0]:
            k_max = (max_right[1] - max_left[1]) / (max_right[0] - max_left[0])
            b_max = max_left[1] - k_max * max_left[0]
        else:
            k_max = float('inf')
            b_max = None

        min_left = (x1-dx1, y1+dy1)
        min_right = (xN+dxN, yN-dyN)
        if min_right[0] != min_left[0]:
            k_min = (min_right[1] - min_left[1]) / (min_right[0] - min_left[0])
            b_min = min_left[1] - k_min * min_left[0]
        else:
            k_min = float('inf')
            b_min = None

        all_x_vals = x_coords + [x1-dx1, x1+dx1, xN-dxN, xN+dxN]
        x_min_all = min(all_x_vals)
        x_max_all = max(all_x_vals)

        x_range = x_max_all - x_min_all
        padding = 0.1 * x_range if x_range != 0 else 1.0
        x_min_plot = x_min_all - padding
        x_max_plot = x_max_all + padding

        plt.figure(figsize=(14, 9))

        plt.errorbar(
            x_coords, y_coords,
            xerr=error_x_coords,
            yerr=error_y_coords,
            fmt='o',
            color='blue',
            ecolor='red',
            elinewidth=1.5,
            capsize=4,
            capthick=1.5,
            markersize=8,
            alpha=0.8,
            label='Экспериментальные точки с погрешностями'
        )

        x_fit = np.linspace(x_min_plot, x_max_plot, 100)
        y_fit = k_mean * x_fit + b_mean
        plt.plot(x_fit, y_fit, 'g-', linewidth=2.5,
                 label=f'Аппроксимация: y = {k_mean:.3f}x + {b_mean:.3f}')

        if k_max != float('inf'):
            x_max_line = np.array([x_min_plot, x_max_plot])
            y_max_line = k_max * x_max_line + b_max
            plt.plot(x_max_line, y_max_line, 'r--', linewidth=2,
                     label=f'Макс. наклон: y = {k_max:.3f}x + {b_max:.3f}')
        else:
            plt.axvline(x=max_left[0], color='r', linestyle='--', linewidth=2,
                        label='Макс. наклон (вертик.)')

        if k_min != float('inf'):
            x_min_line = np.array([x_min_plot, x_max_plot])
            y_min_line = k_min * x_min_line + b_min
            plt.plot(x_min_line, y_min_line, 'b--', linewidth=2,
                     label=f'Мин. наклон: y = {k_min:.3f}x + {b_min:.3f}')
        else:
            plt.axvline(x=min_left[0], color='b', linestyle='--', linewidth=2,
                        label='Мин. наклон (вертик.)')

        area = (k_mean/2 * max(x_coords)**2 + b_mean * max(x_coords)) - \
               (k_mean/2 * min(x_coords)**2 + b_mean * min(x_coords))

        plt.grid(True, alpha=0.3, linestyle='--')
        plt.xlabel('X', fontsize=12)
        plt.ylabel('Y', fontsize=12)
        plt.legend(fontsize=10, loc='best')

        with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as tmpfile:
            plt.savefig(tmpfile.name, dpi=120, bbox_inches='tight', facecolor='white')
            tmpfile_path = tmpfile.name

        plt.close()

        delta_k = None
        if k_max != float('inf') and k_min != float('inf'):
            delta_k = abs(k_max - k_min) / 2

        caption = (
            f"Линейная аппроксимация выполнена.\n\n"
            f"{new_points_text}"
            f"Результаты:\n"
            f"Основная прямая:\n"
            f"  Коэффициент наклона: k = {k_mean:.3f}\n"
            f"  Свободный член: b = {b_mean:.3f}\n"
            f"Максимальный наклон:\n"
            f"  k_max = {k_max:.3f}, b_max = {b_max:.3f}\n"
            f"Минимальный наклон:\n"
            f"  k_min = {k_min:.3f}, b_min = {b_min:.3f}\n"
            + (f"Абсолютная погрешность наклона: Δk = {delta_k:.3f}\n" if delta_k else "") +
            f"Площадь под основным графиком: S = {area:.3f}\n"
        )

        with open(tmpfile_path, 'rb') as photo:
            await context.bot.send_photo(
                chat_id=update.effective_chat.id,
                photo=photo,
                caption=caption
            )

        os.unlink(tmpfile_path)

    except Exception as e:
        await context.bot.send_message(
            chat_id=update.effective_chat.id,
